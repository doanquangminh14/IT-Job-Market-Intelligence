APP_ENV=dev
LOG_LEVEL=INFO

# PostgreSQL (dùng ở Task 05)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=it_jobs
DB_USER=postgres
DB_PASSWORD=change_me

# API key của nguồn dữ liệu (nếu có, Task 03)
SOURCE_01_API_KEY=

# Website Django (web/). Dùng chung DB_USER / DB_PASSWORD / DB_HOST / DB_PORT ở trên.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.com
# Database riêng của website (tách khỏi DB_NAME của pipeline Silver)
WEB_DB_NAME=it_jobs_web
# postgresql (mặc định) hoặc sqlite để chạy thử không cần PostgreSQL
WEB_DB_ENGINE=postgresql
# Khi chạy thật sau reverse proxy HTTPS: bật redirect HTTPS + cookie secure
# DJANGO_SECURE_SSL=True
# docker compose chạy với DEBUG=False; đặt True để bật debug trong container
# DJANGO_DEBUG_DOCKER=False
