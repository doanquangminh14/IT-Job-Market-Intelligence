# Sao chép thành web/.env rồi điền giá trị thật. KHÔNG commit file .env.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.com

# Database: postgresql (mặc định) hoặc sqlite (chạy thử nhanh, không cần PostgreSQL)
DB_ENGINE=postgresql
DB_NAME=it_jobs_web
DB_USER=postgres
DB_PASSWORD=change_me
DB_HOST=localhost
DB_PORT=5432
